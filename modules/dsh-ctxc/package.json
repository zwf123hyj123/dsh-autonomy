{
  "name": "dsh-ctxc",
  "version": "0.2.2",
  "description": "用本地 Ollama 小模型压缩上下文的 dsh-go 插件：输入框「压一下」胶囊 + 每轮对话后自动压缩滚进会话卡",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "publishConfig": { "access": "public" },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "上下文压缩",
      "en": "Ctxc"
    },
    "icon": "summary",
    "wants": [
      "clipboard"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "compress",
          "label": {
            "zh": "压一下",
            "en": "Compress"
          },
          "icon": "summary"
        }
      ],
      "turn.note": [
        {
          "id": "auto-compress"
        }
      ]
    }
  }
}
